{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap.js",
    "dev": "turbo dev",
    "dev:api": "pnpm build && pnpm --filter api dev",
    "dev:api:debug": "pnpm build && pnpm --filter api dev:debug",
    "dev:web": "pnpm build && pnpm --filter web dev",
    "dev:mobile": "pnpm build && pnpm --filter mobile dev",
    "build": "turbo build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "test:api:watch": "pnpm --filter api test:watch",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:migrate:status": "pnpm --filter api db:migrate:status",
    "db:migrate:dev": "pnpm --filter api db:migrate:dev",
    "db:studio": "pnpm --filter api db:studio",
    "db:seed": "pnpm --filter api db:seed",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d --wait postgres redis minio mailpit pgadmin",
    "docker:init": "docker compose -f docker/docker-compose.yml run --rm minio-init",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:prod": "docker compose -f docker/docker-compose.prod.yml up -d --wait",
    "observability:up": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.observability.yml up -d",
    "observability:down": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.observability.yml down",
    "observability:logs": "docker compose -f docker/docker-compose.observability.yml logs -f",
    "clean": "turbo clean && rm -rf node_modules",
    "clean:all": "turbo clean && rm -rf node_modules && rm -rf apps/*/dist && rm -rf packages/*/dist",
    "prepare": "husky",
    "generate:module": "node scripts/generate-module.js",
    "generate:feature": "node scripts/generate-feature.js",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs apps/api/src --output-type err",
    "rules:check-style": "node scripts/check-rules.js",
    "rules:check": "pnpm architecture:check && node scripts/check-rules.js",
    "up": "taze -r"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "dependency-cruiser": "18.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "taze": "^21.1.0",
    "tsx": "^4.23.12",
    "turbo": "^2.10.12",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "apps/api/src/**/*.ts": [
      "pnpm --filter api lint"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
