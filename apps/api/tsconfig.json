{
  "extends": "../../packages/typescript-config/nestjs.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "declaration": false,
    "declarationMap": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "rootDir": "../../",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node16"
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
