{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @repo/email build",
    "dev": "nest start --watch",
    "dev:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "prebuild": "pnpm --filter @repo/email build",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint src --ext .ts",
    "pretest": "pnpm --filter @repo/email build",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:migrate": "node ../../scripts/run-migrations.js up -f ../../migrations/migrate-mongo-config.ts",
    "db:migrate:status": "node ../../scripts/run-migrations.js status -f ../../migrations/migrate-mongo-config.ts",
    "db:migrate:down": "node ../../scripts/run-migrations.js down -f ../../migrations/migrate-mongo-config.ts",
    "db:migrate:dev": "node ../../scripts/run-migrations.js up -f ../../migrations/migrate-mongo-config.ts",
    "db:seed": "ts-node src/seeds/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.0",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-fastify": "^11.1.29",
    "@nestjs/platform-ws": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/websockets": "^11.1.29",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@repo/email": "workspace:*",
    "@ts-rest/core": "^3.26.0",
    "@ts-rest/nest": "^3.26.0",
    "@ts-rest/open-api": "^3.52.1",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "boxen": "8.0.1",
    "bullmq": "^5.12.0",
    "colorette": "^2.0.20",
    "dotenv": "^17.4.2",
    "fastify": "5.11.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2",
    "nestjs-cls": "^6.2.1",
    "neverthrow": "^8.0.0",
    "nodemailer": "^6.9.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "piscina": "^5.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.0",
    "rxjs": "^7.8.0",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.29",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "migrate-mongo": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
