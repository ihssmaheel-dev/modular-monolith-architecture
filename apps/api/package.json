{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run --dir src --exclude '**/*.e2e.test.ts' --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --dir src --include '**/*.integration.test.ts'",
    "test:e2e": "vitest run --dir src --include '**/*.e2e.test.ts'",
    "db:migrate": "migrate-mongo up",
    "db:migrate:dev": "migrate-mongo up",
    "db:seed": "ts-node src/seeds/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/mongoose": "^10.2.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@ts-rest/nest": "^3.26.0",
    "mongoose": "^8.5.0",
    "neverthrow": "^6.1.0",
    "zod": "^3.23.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.0",
    "redis": "^4.7.0",
    "bullmq": "^5.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/node": "^20.14.0",
    "migrate-mongo": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
