{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run --dir src --exclude '**/*.e2e.test.ts' --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --dir src --include '**/*.integration.test.ts'",
    "test:e2e": "vitest run --dir src --include '**/*.e2e.test.ts'",
    "db:migrate": "migrate-mongo up",
    "db:migrate:dev": "migrate-mongo up",
    "db:seed": "ts-node src/seeds/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@repo/email": "workspace:*",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "fastify": "^5.10.0",
    "@nestjs/platform-ws": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@ts-rest/core": "^3.26.0",
    "@ts-rest/nest": "^3.26.0",
    "@ts-rest/open-api": "^3.52.1",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "boxen": "5.1.2",
    "bullmq": "^5.12.0",
    "colorette": "^2.0.20",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.0",
    "nestjs-cls": "^6.2.1",
    "neverthrow": "^8.0.0",
    "nodemailer": "^6.9.0",
    "pino": "^10.0.0",
    "pino-pretty": "^11.2.0",
    "piscina": "^5.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.0",
    "rxjs": "^7.8.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "migrate-mongo": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}