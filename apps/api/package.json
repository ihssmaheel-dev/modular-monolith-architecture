{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run --dir src --exclude '**/*.e2e.test.ts' --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --dir src --include '**/*.integration.test.ts'",
    "test:e2e": "vitest run --dir src --include '**/*.e2e.test.ts'",
    "db:migrate": "migrate-mongo up",
    "db:migrate:dev": "migrate-mongo up",
    "db:seed": "ts-node src/seeds/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@nestjs/platform-ws": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@ts-rest/nest": "^3.26.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "mongoose": "^9.0.0",
    "neverthrow": "^8.0.0",
    "zod": "^4.0.0",
    "pino": "^10.0.0",
    "pino-pretty": "^11.2.0",
    "ioredis": "^5.4.0",
    "bullmq": "^5.12.0",
    "piscina": "^5.0.0",
    "resend": "^4.0.0",
    "nodemailer": "^6.9.0",
    "ws": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.0",
    "@types/ws": "^8.5.0",
    "migrate-mongo": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}