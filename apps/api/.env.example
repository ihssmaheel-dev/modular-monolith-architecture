NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MongoDB
MONGODB_URI=mongodb://localhost:27017/monorepo

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-secret-here

# Storage (gridfs | s3)
STORAGE_DRIVER=gridfs

# S3 (only when STORAGE_DRIVER=s3)
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Email (resend | smtp)
EMAIL_DRIVER=smtp
EMAIL_FROM=noreply@example.com

# Resend (only when EMAIL_DRIVER=resend)
# RESEND_API_KEY=

# SMTP (only when EMAIL_DRIVER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
