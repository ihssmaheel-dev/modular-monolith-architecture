# ==========================================
# ENTERPRISE MONOREPO ENVIRONMENT VARIABLES
# ==========================================

# Core Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Tenancy (single | multi). Choose once before adding production data.
TENANCY_MODE=single

# URLs & CORS
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:3000

# Database & Cache
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Integration/E2E tests only; the database name must contain "test"
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/architecture_test
DB_MAX_POOL_SIZE=10
REDIS_URL=redis://localhost:6379

# Auth & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-prod
JWT_REFRESH_SECRET=your-separate-refresh-secret-change-in-prod
METRICS_TOKEN=optional-development-metrics-token-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL=60

# Account Lockout
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Storage (s3)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# CDN
CDN_ENABLED=false
# CDN_DOMAIN=cdn.example.com
CDN_BUCKET_PATH=uploads

# Email (resend | smtp)
EMAIL_DRIVER=smtp
EMAIL_FROM=noreply@example.com

# Resend (only when EMAIL_DRIVER=resend)
RESEND_API_KEY=

# SMTP (only when EMAIL_DRIVER=smtp)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Optional one-time administrative seed (set both or neither)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace-with-a-long-random-password

