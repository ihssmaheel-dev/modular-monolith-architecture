# ==========================================
# ENTERPRISE MONOREPO ENVIRONMENT VARIABLES
# ==========================================

# Core Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Tenancy (single | multi). Choose once before adding production data.
TENANCY_MODE=single

# URLs & CORS
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:3000

# Database & Cache
MONGODB_URI=mongodb://admin:password@localhost:27017/app?authSource=admin
# Multi-tenant local profile: mongodb://localhost:27018/app?replicaSet=rs0
# Integration/E2E tests only; the database name must contain "test"
TEST_MONGODB_URI=mongodb://admin:password@localhost:27017/architecture_test?authSource=admin
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_HEARTBEAT_FREQUENCY_MS=10000

REDIS_URL=redis://localhost:6379

# Auth & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-prod
JWT_REFRESH_SECRET=your-separate-refresh-secret-change-in-prod
METRICS_TOKEN=optional-development-metrics-token-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL=60

# Storage (gridfs | s3)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Email (resend | smtp)
EMAIL_DRIVER=smtp
EMAIL_FROM=noreply@example.com

# Resend (only when EMAIL_DRIVER=resend)
# RESEND_API_KEY=

# SMTP (only when EMAIL_DRIVER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=

# Optional one-time administrative seed (set both or neither)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace-with-a-long-random-password
