POSTGRES_USER=replace-with-a-database-user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=app
DATABASE_URL=postgres://replace-with-a-url-encoded-user:replace-with-a-url-encoded-password@postgres:5432/app
TENANCY_MODE=single

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
METRICS_TOKEN=replace-with-another-32-character-random-secret
CLIENT_URL=https://app.example.com

MINIO_USER=replace-with-an-access-key
MINIO_PASSWORD=replace-with-a-long-random-secret
S3_BUCKET=uploads

EMAIL_DRIVER=smtp
EMAIL_FROM=noreply@example.com
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

