# Secrets: prefer <NAME>_FILE pointing at a mounted secret file
# (Docker secrets, Vault agent, AWS SM). Example:
#   JWT_SECRET_FILE=/run/secrets/jwt_secret
# Direct values below are fallback for simple hosts.
DATABASE_URL=postgres://replace-with-a-url-encoded-user:replace-with-a-url-encoded-password@db.example.net:5432/app?sslmode=verify-full
REDIS_URL=rediss://replace-with-redis-host.example.net:6380
TENANCY_MODE=single
AUDIT_RETENTION_DAYS=365

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
METRICS_TOKEN=replace-with-another-32-character-random-secret
CLIENT_URL=https://app.example.com
API_URL=https://api.example.com
VITE_API_URL=https://api.example.com/api

S3_ACCESS_KEY_ID=replace-with-an-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
S3_ENDPOINT=https://storage.example.com
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false
S3_BUCKET=uploads

EMAIL_DRIVER=smtp
EMAIL_FROM=noreply@app.example.com
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

